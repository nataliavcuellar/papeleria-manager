# URL JDBC de la base MySQL local que debe existir antes de iniciar la aplicación.
PAPELERIA_DB_URL=jdbc:mysql://localhost:3306/rositapapeleria
# Usuario local de MySQL.
PAPELERIA_DB_USER=usuario_mysql_local
# Contraseña local de MySQL; reemplazar por una credencial de desarrollo.
PAPELERIA_DB_PASSWORD=CAMBIAR_POR_CREDENCIAL_LOCAL
